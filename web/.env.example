# Copy to .env.development.local (never commit *.local).
# Get both URLs from Neon Console → project adminflow-v1 → branch "development" → Auth / Data API.
# These are public client endpoints (not secrets), but keep production URLs out of development files.
VITE_NEON_AUTH_URL=https://ep-xxxx.neonauth.c-4.ap-southeast-1.aws.neon.tech/neondb/auth
VITE_NEON_DATA_API_URL=https://ep-xxxx.apirest.c-4.ap-southeast-1.aws.neon.tech/neondb/rest/v1
